# 环境变量模板
# 复制此文件为 .env 并填入实际值

# 后端
DATABASE_URL=postgresql://todo:todo@db:5432/todoapp
JWT_SECRET=change-me-in-production-use-random-64-chars
JWT_EXPIRES_IN=7d
PORT=3000
CORS_ORIGIN=http://localhost

# Docker Compose 使用
JWT_SECRET=change-me-in-production-use-random-64-chars
CORS_ORIGIN=http://localhost
