<!--pages/history/history.wxml-->
<view class="page">
  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:else class="content">
    <!-- 月份切换 -->
    <view class="month-nav">
      <view class="nav-btn" bindtap="onPrevMonth">
        <text class="nav-arrow">&#60;</text>
      </view>
      <text class="month-title">{{year}}年{{month}}月</text>
      <view class="nav-btn" bindtap="onNextMonth">
        <text class="nav-arrow">&#62;</text>
      </view>
    </view>

    <!-- 星期头 -->
    <view class="weekday-header">
      <text class="weekday-item" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
    </view>

    <!-- 日历网格 -->
    <view class="calendar-grid">
      <!-- 空白占位 -->
      <view
        wx:for="{{emptyDays}}"
        wx:key="index"
        class="calendar-day empty"
      ></view>

      <!-- 日期格子 -->
      <view
        wx:for="{{days}}"
        wx:key="date"
        class="calendar-day {{item.isToday ? 'today' : ''}} {{item.isCheckedIn ? 'checked' : ''}} {{item.isFuture ? 'future' : ''}}"
      >
        <text class="day-number">{{item.day}}</text>
        <view wx:if="{{item.isCheckedIn}}" class="check-dot"></view>
      </view>
    </view>

    <!-- 本月统计 -->
    <view class="stats-card card">
      <view class="stats-row">
        <view class="stats-item">
          <text class="stats-value">{{totalCheckins}}</text>
          <text class="stats-label">已打卡</text>
        </view>
        <view class="stats-divider"></view>
        <view class="stats-item">
          <text class="stats-value">{{totalDays}}</text>
          <text class="stats-label">总天数</text>
        </view>
        <view class="stats-divider"></view>
        <view class="stats-item">
          <text class="stats-value">{{checkinRate}}</text>
          <text class="stats-label">打卡率</text>
        </view>
      </view>
    </view>
  </view>
</view>
